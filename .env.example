# Template for local keys. Copy the values you need into your shell (or .env.txt, which is
# gitignored) and never commit real keys. No script reads this file: a key reaches a run as an
# environment variable.

# xAI (X search). Fane does NOT read this as an environment variable: patch-x-search takes the
# key from the Vane provider whose Base URL is https://api.x.ai/v1 (Vane Settings -> Models,
# OpenAI-compatible type). A real key starts with "xai-". Listed here so you know where it is from.
XAI_API_KEY=xai-your-key-here

# Keys read by scripts/apply.mjs and docker-compose.yml (SearXNG engines). Empty = engine off.
CORE_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=
PERPLEXITY_API_KEY=

# For scripts that call OpenRouter directly (benchmarks, trials); or pass --key-from-vane.
OPENROUTER_API_KEY=

# Optional x_search tuning (defaults: grok-4.7, 2 calls per research).
# FANE_X_MODEL=grok-4.7
# FANE_X_MAX_CALLS=2
